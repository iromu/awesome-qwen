---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SkillDetail } from "../../components/brand/SkillDetail";
import { buildDetailToc } from "../../components/brand/DetailChassis";
import skillsData from "../../../public/data/skills.json";
import { searchIndex } from "../../lib/site-data";
import { readSkillMarkdown, formatLastUpdated } from "../../lib/detail-page";

const GITHUB_TREE_BASE = "https://github.com/iromu/awesome-qwen/tree/main";
const GITHUB_BLOB_BASE = "https://github.com/iromu/awesome-qwen/blob/main";
const RAW_BASE = "https://raw.githubusercontent.com/iromu/awesome-qwen/main";
const CLONE_URL = "https://github.com/iromu/awesome-qwen.git";

interface SkillFile {
  path: string;
  name: string;
  size?: number;
}

interface QualityScore {
  score: number;
  grade: string;
  type: string;
  status: string | null;
  dimensions: {
    correctness: number;
    discoverability: number;
    reliability: number;
    efficiency: number;
  };
  reportPath: string;
}

interface SkillItem {
  id: string;
  name?: string;
  title: string;
  description?: string;
  path: string;
  skillFile: string;
  files?: SkillFile[];
  assets?: string[];
  hasAssets?: boolean;
  assetCount?: number;
  lastUpdated?: string | null;
  qualityScore?: QualityScore | null;
}

export function getStaticPaths() {
  const items = skillsData.items as SkillItem[];
  return items.map((item, index) => ({
    params: { id: item.id },
    props: {
      item,
      previous: index > 0 ? items[index - 1] : undefined,
      next: index < items.length - 1 ? items[index + 1] : undefined,
    },
  }));
}

const { item, previous, next } = Astro.props as {
  item: SkillItem;
  previous?: SkillItem;
  next?: SkillItem;
};

// Skills are folders, so the content region is a file switcher: SKILL.md is
// read directly and the remaining bundled files are fetched on demand.
const { markdownHtml, rawMarkdown } = readSkillMarkdown(item.skillFile);
const lastUpdated = formatLastUpdated(item.lastUpdated);

const { html } = buildDetailToc(markdownHtml);

const githubUrl = `${GITHUB_TREE_BASE}/${item.path}`;
const installCommand = `git clone ${CLONE_URL} && cp -r awesome-qwen/${item.path} .qwen/skills/`;

const base = import.meta.env.BASE_URL ?? "/";
const detailHref = (id: string) =>
  `${base.endsWith("/") ? base : `${base}/`}skill/${id}/`.replace(/\/{2,}/g, "/");

const siblingOf = (sibling?: SkillItem) =>
  sibling ? { label: sibling.title, href: detailHref(sibling.id) } : undefined;
---

<BaseLayout title={`${item.title} | Awesome Qwen`} description={item.description}>
  <SkillDetail
    client:load
    item={item}
    markdownHtml={html}
    githubUrl={githubUrl}
    githubBlobBase={GITHUB_BLOB_BASE}
    rawBase={RAW_BASE}
    installCommand={installCommand}
    rawMarkdown={rawMarkdown}
    lastUpdated={lastUpdated}
    previous={siblingOf(previous)}
    next={siblingOf(next)}
    searchIndex={searchIndex}
  />
</BaseLayout>
